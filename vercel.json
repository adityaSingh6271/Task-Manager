{
  "version": 2,
  "builds": [
    {
      "src": "Backend/src/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "Frontend/my-app/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/Backend/src/index.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/Frontend/my-app/$1"
    }
  ]
}
